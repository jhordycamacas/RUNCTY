# Copy to .env and fill in. Never commit .env.
# With the local emulators these placeholders are enough: the emulators accept any API key.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-runcty.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-runcty
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-runcty.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Connect to the Firebase emulators (true for local development).
EXPO_PUBLIC_USE_EMULATORS=true
# Host running the emulators. Leave empty for defaults (127.0.0.1 on iOS simulator, 10.0.2.2 on Android emulator).
# On a physical device use your computer's LAN IP, e.g. 192.168.1.20.
EXPO_PUBLIC_EMULATOR_HOST=
