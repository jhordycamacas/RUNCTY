# Copiar este archivo como backend/.env y cambiar las claves. backend/.env no se sube a git.
DB_NAME=runcty
DB_USER=runcty_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3307

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost,http://localhost:4200,capacitor://localhost,https://localhost

# Solo para correr las pruebas sin MySQL: DB_ENGINE=sqlite (por defecto se usa MySQL).
