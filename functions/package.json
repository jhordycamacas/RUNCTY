{
  "name": "runcty-functions",
  "private": true,
  "description": "Cloud Functions (Gen 2) for RUNCTY",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:rules": "firebase emulators:exec --only firestore --project demo-runcty \"vitest run --dir test/rules\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
