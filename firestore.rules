rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Roles and permissions live only in the custom claims `{ role, perms }`,
    // assigned by Cloud Functions (RF-02). No get() of role docs here.
    function hasRole(r) {
      return isSignedIn() && request.auth.token.role == r;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // Permission from the catalog in functions/src/roles/permissions.ts.
    // `admin` is a superuser fallback for tokens issued before `perms` existed.
    function hasPerm(p) {
      return isSignedIn() && (isAdmin() || p in request.auth.token.get('perms', []));
    }

    // ---------- Users ----------

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    // Editable personal data. Age limits are enforced by the app; the rules
    // only guard the shape (ISO YYYY-MM-DD).
    function hasValidPersonalData(d) {
      return isNonEmptyString(d.firstName, 60)
        && isNonEmptyString(d.lastName, 60)
        && d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isNonEmptyString(d.cityId, 64)
        && (!('idNumber' in d) || (d.idNumber is string && d.idNumber.matches('^[0-9]{10}$')));
    }

    // Sign-up payload: no role (assigned by Cloud Functions), the uid and email
    // of the token, explicit LOPDP consent and server timestamps.
    function isValidNewUser(d) {
      return d.keys().hasAll(['uid', 'email', 'firstName', 'lastName', 'birthDate', 'cityId', 'consent', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'email', 'firstName', 'lastName', 'birthDate', 'cityId', 'idNumber', 'consent', 'createdAt', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && hasValidPersonalData(d)
        && d.consent is map
        && d.consent.keys().hasOnly(['lopdp', 'acceptedAt'])
        && d.consent.lopdp == true
        && d.consent.acceptedAt == request.time
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      // RF-01-2: the admin panel searches users through the `searchUsers`
      // callable; direct reads are allowed with the same permission.
      allow read: if isOwner(uid) || hasPerm('users.read');

      allow create: if isOwner(uid) && isValidNewUser(request.resource.data);

      // Owners edit only their personal data (RF-01-3). role, uid, email,
      // consent and createdAt are immutable for clients.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['firstName', 'lastName', 'birthDate', 'cityId', 'idNumber', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && hasValidPersonalData(request.resource.data);

      // No client delete: the `deleteAccount` callable removes the account.

      // Private sub-documents (sport profile, preferences).
      // Only the known sub-documents can be written, each with its schema.
      match /private/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && ((docId == 'sportProfile' && isValidSportProfile(request.resource.data))
            || (docId == 'preferences' && isValidPreferences(request.resource.data)));
      }
    }

    // RF-01-9..12. Only the shape: the options (levels, goals) and the pace and distance ranges are
    // system parameters an admin edits (`catalogs`, `systemSettings`), so the Django API, which
    // writes the profile with the Admin SDK, is the one that validates them.
    function isValidSportProfile(d) {
      return d.keys().hasAll(['level', 'goals', 'usualPaceSecPerKm', 'preferredDistanceKm', 'updatedAt'])
        && d.keys().hasOnly(['level', 'goals', 'usualPaceSecPerKm', 'preferredDistanceKm', 'updatedAt'])
        && d.level is string
        && d.goals is list
        && d.goals.size() >= 1
        && d.usualPaceSecPerKm is number
        && d.preferredDistanceKm is number
        && d.updatedAt == request.time;
    }

    // RF-01-13..16. Mirrors the app's zod schema. Deleting the doc resets
    // the preferences to the app defaults.
    function isValidPreferences(d) {
      return d.keys().hasAll(['language', 'fontScale', 'appearance', 'units', 'notifications', 'locationPrivacy', 'updatedAt'])
        && d.keys().hasOnly(['language', 'fontScale', 'appearance', 'units', 'notifications', 'locationPrivacy', 'updatedAt'])
        && d.language in ['es']
        && d.fontScale in ['small', 'normal', 'large', 'xlarge']
        && d.appearance in ['system', 'light', 'dark']
        && d.units in ['metric', 'imperial']
        && d.notifications is map
        && d.notifications.keys().hasAll(['enabled', 'safetyAlerts', 'events'])
        && d.notifications.keys().hasOnly(['enabled', 'safetyAlerts', 'events'])
        && d.notifications.enabled is bool
        && d.notifications.safetyAlerts is bool
        && d.notifications.events is bool
        && d.locationPrivacy in ['trustedContactsDuringSession', 'off']
        && d.updatedAt == request.time;
    }

    // ---------- Catalogs ----------

    // Public catalog without personal data: the sign-up form lists the
    // active cities before the user has an account.
    // RF-04: written from the admin panel with `cities.manage`. Deletion goes
    // through the `deleteCity` callable, which rejects cities with routes or
    // zones (RF-04-4).
    match /cities/{cityId} {
      allow read: if true;

      allow create: if hasPerm('cities.manage')
        && isValidCity(request.resource.data, cityId)
        && request.resource.data.createdAt == request.time;

      // type and createdAt are immutable (a city with zones cannot become a zone).
      allow update: if hasPerm('cities.manage')
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'province', 'country', 'location', 'coverage', 'parentCityId', 'updatedAt'])
        && request.resource.data.type == resource.data.get('type', 'city')
        && isValidCity(request.resource.data, cityId);

      allow delete: if false;
    }

    function isValidCity(d, cityId) {
      return d.keys().hasAll(['name', 'province', 'country', 'type', 'location', 'coverage', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'province', 'country', 'type', 'parentCityId', 'location', 'coverage', 'createdAt', 'updatedAt'])
        && isNonEmptyString(d.name, 80)
        && isNonEmptyString(d.province, 80)
        && d.country is string && d.country.size() == 2
        && d.coverage in ['active', 'planned', 'suspended']
        && d.location is map
        && d.location.keys().hasAll(['lat', 'lng'])
        && d.location.keys().hasOnly(['lat', 'lng'])
        && d.location.lat is number && d.location.lat >= -90 && d.location.lat <= 90
        && d.location.lng is number && d.location.lng >= -180 && d.location.lng <= 180
        && d.updatedAt == request.time
        && ((d.type == 'city' && !('parentCityId' in d))
          || (d.type == 'zone' && isValidParentCity(d.parentCityId, cityId)));
    }

    // A zone belongs to an existing city (not to another zone).
    function isValidParentCity(parentId, cityId) {
      return isNonEmptyString(parentId, 64)
        && parentId != cityId
        && exists(/databases/$(database)/documents/cities/$(parentId))
        && get(/databases/$(database)/documents/cities/$(parentId)).data.get('type', 'city') == 'city';
    }

    // RF-02: readable by signed-in users; written only by the role callables
    // (createRole, updateRole, deleteRole), which also re-sync the claims.
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- Routes (RF-05, RF-07) ----------

    // Runners see only active routes; admins with `routes.manage` see all.
    // Every write goes through the route callables, which validate, keep the
    // segment order and recalculate the safety index atomically.
    function canReadRoute(routeId) {
      return hasPerm('routes.manage')
        || (isSignedIn()
          && get(/databases/$(database)/documents/routes/$(routeId)).data.get('active', false) == true);
    }

    match /routes/{routeId} {
      allow read: if isSignedIn()
        && (resource.data.get('active', false) == true || hasPerm('routes.manage'));
      allow write: if false;

      match /segments/{segmentId} {
        allow read: if canReadRoute(routeId);
        allow write: if false;

        match /riskFactors/{factorId} {
          allow read: if canReadRoute(routeId);
          allow write: if false;
        }
      }

      match /timeSlots/{slotId} {
        allow read: if canReadRoute(routeId);
        allow write: if false;
      }
    }

    // ---------- Sprint 3 (EP-06, EP-07 alerts, EP-08, EP-09) ----------

    // Only the Django API reads and writes these collections (Admin SDK):
    // it applies `routes.manage`, the signed-in reads and the ownership of
    // safe route requests. Clients never access them directly.
    match /informationSources/{sourceId} {
      allow read, write: if false;
    }

    match /safetyIncidents/{incidentId} {
      allow read, write: if false;
    }

    match /supportPoints/{pointId} {
      allow read, write: if false;
    }

    match /guardedTrails/{trailId} {
      allow read, write: if false;
    }

    match /riskZoneAlerts/{alertId} {
      allow read, write: if false;
    }

    match /safeRouteRequests/{requestId} {
      allow read, write: if false;
    }

    // System parameters (`systemSettings/global`): only the Django API reads
    // and writes them (Admin SDK), applying `settings.manage` for changes.
    match /systemSettings/{settingId} {
      allow read, write: if false;
    }

    // Option catalogs (`catalogs/{id}`: sport levels and goals): only the Django API
    // reads and writes them (Admin SDK), applying `settings.manage` for changes.
    match /catalogs/{catalogId} {
      allow read, write: if false;
    }

    // Everything else is denied by default (no matching rule).
  }
}
