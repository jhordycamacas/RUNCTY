rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Roles live only in the custom claim `role`, assigned by Cloud Functions.
    function hasRole(r) {
      return isSignedIn() && request.auth.token.role == r;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // ---------- Users ----------

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    // Editable personal data. Age limits are enforced by the app; the rules
    // only guard the shape (ISO YYYY-MM-DD).
    function hasValidPersonalData(d) {
      return isNonEmptyString(d.firstName, 60)
        && isNonEmptyString(d.lastName, 60)
        && d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isNonEmptyString(d.cityId, 64)
        && (!('idNumber' in d) || (d.idNumber is string && d.idNumber.matches('^[0-9]{10}$')));
    }

    // Sign-up payload: no role (assigned by Cloud Functions), the uid and email
    // of the token, explicit LOPDP consent and server timestamps.
    function isValidNewUser(d) {
      return d.keys().hasAll(['uid', 'email', 'firstName', 'lastName', 'birthDate', 'cityId', 'consent', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'email', 'firstName', 'lastName', 'birthDate', 'cityId', 'idNumber', 'consent', 'createdAt', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && hasValidPersonalData(d)
        && d.consent is map
        && d.consent.keys().hasOnly(['lopdp', 'acceptedAt'])
        && d.consent.lopdp == true
        && d.consent.acceptedAt == request.time
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid) && isValidNewUser(request.resource.data);

      // Owners edit only their personal data (RF-01-3). role, uid, email,
      // consent and createdAt are immutable for clients.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['firstName', 'lastName', 'birthDate', 'cityId', 'idNumber', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && hasValidPersonalData(request.resource.data);

      // No client delete: the `deleteAccount` callable removes the account.

      // Private sub-documents (sport profile, preferences).
      // Only the known sub-documents can be written, each with its schema.
      match /private/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && ((docId == 'sportProfile' && isValidSportProfile(request.resource.data))
            || (docId == 'preferences' && isValidPreferences(request.resource.data)));
      }
    }

    // RF-01-9..12. Mirrors the app's zod schema.
    function isValidSportProfile(d) {
      return d.keys().hasAll(['level', 'goals', 'usualPaceSecPerKm', 'preferredDistanceKm', 'updatedAt'])
        && d.keys().hasOnly(['level', 'goals', 'usualPaceSecPerKm', 'preferredDistanceKm', 'updatedAt'])
        && d.level in ['beginner', 'intermediate', 'advanced']
        && d.goals is list
        && d.goals.size() >= 1
        && d.goals.size() <= 5
        && d.goals.hasOnly(['health', 'weightLoss', 'racePrep', 'pace', 'social'])
        && d.usualPaceSecPerKm is number
        && d.usualPaceSecPerKm >= 150
        && d.usualPaceSecPerKm <= 1200
        && d.preferredDistanceKm is number
        && d.preferredDistanceKm >= 1
        && d.preferredDistanceKm <= 50
        && d.updatedAt == request.time;
    }

    // RF-01-13..16. Mirrors the app's zod schema. Deleting the doc resets
    // the preferences to the app defaults.
    function isValidPreferences(d) {
      return d.keys().hasAll(['language', 'fontScale', 'appearance', 'units', 'notifications', 'locationPrivacy', 'updatedAt'])
        && d.keys().hasOnly(['language', 'fontScale', 'appearance', 'units', 'notifications', 'locationPrivacy', 'updatedAt'])
        && d.language in ['es']
        && d.fontScale in ['small', 'normal', 'large', 'xlarge']
        && d.appearance in ['system', 'light', 'dark']
        && d.units in ['metric', 'imperial']
        && d.notifications is map
        && d.notifications.keys().hasAll(['enabled', 'safetyAlerts', 'events'])
        && d.notifications.keys().hasOnly(['enabled', 'safetyAlerts', 'events'])
        && d.notifications.enabled is bool
        && d.notifications.safetyAlerts is bool
        && d.notifications.events is bool
        && d.locationPrivacy in ['trustedContactsDuringSession', 'off']
        && d.updatedAt == request.time;
    }

    // ---------- Catalogs ----------

    // Public catalog without personal data: the sign-up form lists the
    // active cities before the user has an account.
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Everything else is denied by default (no matching rule).
  }
}
