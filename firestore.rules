rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Roles live only in the custom claim `role`, assigned by Cloud Functions.
    function hasRole(r) {
      return isSignedIn() && request.auth.token.role == r;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // ---------- Users ----------

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    // Editable personal data. Age limits are enforced by the app; the rules
    // only guard the shape (ISO YYYY-MM-DD).
    function hasValidPersonalData(d) {
      return isNonEmptyString(d.firstName, 60)
        && isNonEmptyString(d.lastName, 60)
        && d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isNonEmptyString(d.cityId, 64)
        && (!('idNumber' in d) || (d.idNumber is string && d.idNumber.matches('^[0-9]{10}$')));
    }

    // Sign-up payload: no role (assigned by Cloud Functions), the uid and email
    // of the token, explicit LOPDP consent and server timestamps.
    function isValidNewUser(d) {
      return d.keys().hasAll(['uid', 'email', 'firstName', 'lastName', 'birthDate', 'cityId', 'consent', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'email', 'firstName', 'lastName', 'birthDate', 'cityId', 'idNumber', 'consent', 'createdAt', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && hasValidPersonalData(d)
        && d.consent is map
        && d.consent.keys().hasOnly(['lopdp', 'acceptedAt'])
        && d.consent.lopdp == true
        && d.consent.acceptedAt == request.time
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid) && isValidNewUser(request.resource.data);

      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'uid', 'email', 'createdAt']);

      // Private sub-documents (sport profile, preferences).
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------- Catalogs ----------

    // Public catalog without personal data: the sign-up form lists the
    // active cities before the user has an account.
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Everything else is denied by default (no matching rule).
  }
}
